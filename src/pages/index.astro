---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ArrowLeftLight from 'phosphor-astro/ArrowLeftLight.astro';
import ArrowRightLight from 'phosphor-astro/ArrowRightLight.astro';
import PhoneLight from 'phosphor-astro/PhoneLight.astro';
import WhatsappLogoLight from 'phosphor-astro/WhatsappLogoLight.astro';
import InstagramLogoLight from 'phosphor-astro/InstagramLogoLight.astro';
import FacebookLogoLight from 'phosphor-astro/FacebookLogoLight.astro';
import sucursales from '../data/sucursales.json';
import marcas from '../data/marcas.json';
import sitio from '../data/sitio.json';
import lineas from '../data/lineas.json';

const title = 'Arkirámica — Pisos, baños y plomería en Puerto Vallarta, Bahía de Banderas y Guadalajara';
const url = Astro.site?.href ?? '/';
const mapSrc = (s: { lat: number; lon: number }) => `https://www.google.com/maps?q=${s.lat},${s.lon}&z=15&hl=es&output=embed`;
const conTelefono = sucursales.filter((s) => s.telefono);
const slugify = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${url}#org`,
      name: sitio.nombre,
      legalName: sitio.razonSocial,
      url,
      telephone: sitio.telefono,
      email: sitio.correo,
      sameAs: sitio.redes.map((r) => r.url),
    },
    ...sucursales.map((s) => ({
      '@type': 'HomeAndConstructionBusiness',
      '@id': `${url}#${s.id}`,
      name: `Arkirámica ${s.nombre}`,
      description: sitio.descripcion,
      url,
      email: sitio.correo,
      telephone: s.telefono ?? sitio.telefono,
      address: { '@type': 'PostalAddress', streetAddress: s.direccion.split(',')[0], addressLocality: s.ciudad, addressRegion: s.estado, postalCode: s.cp, addressCountry: 'MX' },
      geo: { '@type': 'GeoCoordinates', latitude: s.lat, longitude: s.lon },
      hasMap: s.maps,
      sameAs: sitio.redes.map((r) => r.url),
      openingHoursSpecification: s.horario
        .filter((h) => 'ld' in h)
        .map((h: any) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.ld, opens: h.abre, closes: h.cierra })),
    })),
  ],
};

---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={sitio.descripcion} />
    <meta name="theme-color" content="#161718" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={sitio.descripcion} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="es_MX" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var seen = false;
        try { seen = sessionStorage.getItem('arkIntro') === '1'; } catch (e) {}
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var off = /[?&]intro=0/.test(location.search);
        if (!seen && !reduce && !off) d.classList.add('intro');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <!-- Intro: el logo se escribe. Una vez por sesión, se salta con clic, tecla o scroll. -->
    <div id="intro" aria-hidden="true">
      <div class="intro__curtain"></div>
      <div class="intro__stage">
        <Logo variant="full" class="intro__logo" decorative />
        <span class="intro__line"></span>
      </div>
    </div>

    <header class="header" id="header">
      <div class="container header__in">
        <a class="header__logo" href="#inicio" aria-label="Arkirámica, ir al inicio">
          <Logo variant="mark" decorative />
        </a>
        <button class="header__toggle" type="button" aria-expanded="false" aria-controls="nav">
          <span class="sr-only">Menú</span>
          <span class="header__bars" aria-hidden="true"></span>
        </button>
        <nav class="nav" id="nav" aria-label="Principal">
          <a href="#lineas">Qué hacemos</a>
          <a href="#marcas">Marcas</a>
          <a href="#sucursales">Sucursales</a>
          <a class="nav__cta" href="#contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <!-- HERO -->
      <section class="hero" id="inicio" aria-labelledby="hero-t">
        <div class="hero__media" aria-hidden="true">
          <video class="hero__video" src="/videohero.mp4" autoplay muted loop playsinline webkit-playsinline preload="auto"></video>
          <div class="hero__scrim"></div>
        </div>
        <div class="hero__grid" aria-hidden="true"></div>
        <div class="container hero__in">
          <div class="hero__copy">
            <p class="eyebrow" data-enter style="--d:0ms">Pisos · Baños · Plomería</p>
            <h1 id="hero-t" data-enter style="--d:80ms">Superficies que <em>construyen</em> espacios.</h1>
            <p class="lead" data-enter style="--d:160ms">
              Materiales y acabados de las mejores marcas para tu obra, remodelación o proyecto.
              Te atendemos en Puerto Vallarta, Bahía de Banderas y Guadalajara.
            </p>
            <div class="hero__cta" data-enter style="--d:240ms">
              <a class="btn btn--green" href="#sucursales">
                Ver sucursales
                <ArrowRightLight aria-hidden="true" />
              </a>
              <a class="link" href="#marcas">Conoce las marcas</a>
            </div>
          </div>
        </div>
      </section>

      <!-- QUÉ HACEMOS -->
      <section class="sec sec--stone" id="lineas" aria-labelledby="lineas-t">
        <div class="container">
          <div class="sec__head reveal">
            <p class="eyebrow">Qué hacemos</p>
            <h2 id="lineas-t">Todo para tu obra, del piso al último detalle.</h2>
          </div>
          <ol class="lineas" id="lineas-track">
            {lineas.map((l, i) => (
              <li class:list={['linea', 'reveal', `linea--${slugify(l.titulo)}`]} style={`--d:${(i % 3) * 80}ms`}>
                <div class="linea__head">
                  <span class="linea__n">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{l.titulo}</h3>
                </div>
                {l.foto && <img class="linea__img" src={l.foto} alt="" loading="lazy" decoding="async" />}
                <p>{l.texto}</p>
              </li>
            ))}
          </ol>
          <div class="lineas__meta" aria-hidden="true">
            <span>Desliza para explorar</span>
            <span class="lineas__count" id="lineas-count">01 / {String(lineas.length).padStart(2, '0')}</span>
          </div>
        </div>
      </section>

      <!-- MARCAS -->
      <section class="sec sec--marcas" id="marcas" aria-labelledby="marcas-t">
        <div class="container marcas__head reveal">
          <div>
            <p class="eyebrow">Marcas</p>
            <h2 id="marcas-t">Trabajamos con las marcas que eligen los profesionales.</h2>
          </div>
          <div class="marcas__ctrl">
            <button type="button" class="arrow" data-dir="-1" aria-label="Marcas anteriores">
              <ArrowLeftLight aria-hidden="true" />
            </button>
            <button type="button" class="arrow" data-dir="1" aria-label="Marcas siguientes">
              <ArrowRightLight aria-hidden="true" />
            </button>
          </div>
        </div>
        <div class="marquee" id="marquee" role="region" aria-roledescription="carrusel" aria-label="Marcas con las que trabajamos" tabindex="0">
          <div class="marquee__track">
            {[0, 1].map((copy) => (
              <ul class="marquee__set" aria-hidden={copy === 1 ? 'true' : undefined}>
                {marcas.map((m) => (
                  <li>
                    <img
                      src={`/marcas/${m.archivo}`}
                      alt={copy === 0 ? `Logo de ${m.nombre}` : ''}
                      style={`--s:${m.escala}`}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
        <p class="container marcas__hint">Arrastra para explorar</p>
      </section>

      <!-- SUCURSALES -->
      <section class="sec sec--stone" id="sucursales" aria-labelledby="suc-t">
        <div class="container">
          <div class="sec__head reveal">
            <p class="eyebrow">Sucursales</p>
            <h2 id="suc-t">Visítanos. Te asesoramos en persona.</h2>
          </div>
          <div class="suc">
            <ul class="suc__list">
              {sucursales.map((s, i) => (
                <li class="card reveal" id={s.id} style={`--d:${i * 70}ms`}>
                  <div class="card__top">
                    <h3>{s.nombre}</h3>
                    <span class="card__zona">{s.zona}</span>
                  </div>
                  <address>{s.direccion}</address>
                  <dl class="card__hrs">
                    {s.horario.map((h) => (
                      <div><dt>{h.dias}</dt><dd>{h.horas}</dd></div>
                    ))}
                  </dl>
                  <div class="card__act">
                    {s.telefono && (
                      <a class="btn btn--ink" href={`tel:${s.telefono}`}>
                        <PhoneLight aria-hidden="true" />
                        <span class="sr-only">Llamar a {s.nombre}: </span>{s.telefonoVisible}
                      </a>
                    )}
                    <a class="link" href={s.maps} target="_blank" rel="noopener">Cómo llegar<span class="sr-only"> a {s.nombre} (abre Google Maps)</span></a>
                    <button type="button" class="link card__map" data-map={mapSrc(s)} data-name={s.nombre} aria-pressed={i === 0 ? 'true' : 'false'}>Ver en el mapa</button>
                  </div>
                </li>
              ))}
            </ul>
            <div class="suc__map reveal">
              <iframe
                id="mapa"
                title={`Mapa de la sucursal ${sucursales[0].nombre}`}
                src={mapSrc(sucursales[0])}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <!-- CONTACTO -->
      <section class="sec sec--ink sec--con" id="contacto" aria-labelledby="con-t">
        <svg class="section-tab" viewBox="0 0 1440 32" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0,0 H1440 V30 H760 L660,2 H0 Z" fill="var(--ark-stone)" />
          <path class="section-tab__line" d="M0,2 H660 L760,30 H1440" fill="none" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>
        <div class="container con">
          <div class="con__info reveal">
            <p class="eyebrow">Contacto</p>
            <h2 id="con-t">Hablemos de tu proyecto.</h2>
            <p class="lead">Llámanos o escríbenos por WhatsApp al número de atención a clientes, contacta tu sucursal más cercana o envíanos un correo.</p>
          </div>
          <div class="con__data reveal">
            <ul class="con__tels">
              <li class="con__main">
                <span>Atención a clientes · Teléfono y WhatsApp</span>
                <a href={`tel:${sitio.telefono}`}>{sitio.telefonoVisible}</a>
              </li>
              <li class="con__main">
                <span>Correo</span>
                <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a>
              </li>
              {conTelefono.map((s) => (
                <li>
                  <span>{s.nombre}{s.nombre !== s.ciudad ? '' : ` · ${s.zona}`}</span>
                  <a href={`tel:${s.telefono}`}>{s.telefonoVisible}</a>
                </li>
              ))}
            </ul>
            <ul class="redes">
              <li>
                <a href={sitio.whatsapp} target="_blank" rel="noopener">
                  <WhatsappLogoLight aria-hidden="true" />
                  <span>WhatsApp</span>
                  <span class="redes__u">{sitio.telefonoVisible}</span>
                </a>
              </li>
              {sitio.redes.map((r) => (
                <li>
                  <a href={r.url} target="_blank" rel="noopener">
                    {r.nombre === 'Instagram' ? (
                      <InstagramLogoLight aria-hidden="true" />
                    ) : (
                      <FacebookLogoLight aria-hidden="true" />
                    )}
                    <span>{r.nombre}</span>
                    <span class="redes__u">{r.usuario}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <svg class="section-tab section-tab--footer" viewBox="0 0 1440 32" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,0 H1440 V30 H760 L660,2 H0 Z" fill="var(--ark-ink)" />
        <path class="section-tab__line" d="M0,2 H660 L760,30 H1440" fill="none" stroke-width="1.5" vector-effect="non-scaling-stroke" />
      </svg>
      <div class="container footer__in">
        <Logo variant="full" class="footer__logo" />
        <nav class="footer__nav" aria-label="Pie de página">
          <a href="#lineas">Qué hacemos</a>
          <a href="#marcas">Marcas</a>
          <a href="#sucursales">Sucursales</a>
          <a href="#contacto">Contacto</a>
          {sitio.redes.map((r) => <a href={r.url} target="_blank" rel="noopener">{r.nombre}</a>)}
        </nav>
        <p class="footer__legal">© {new Date().getFullYear()} {sitio.razonSocial}</p>
      </div>
    </footer>

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
